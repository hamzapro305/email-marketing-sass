# ─────────────────────────────────────────────────────────────
# Email Marketing SaaS — Backend environment
# Copy this file to `.env` and adjust as needed. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Backend HTTP port
PORT=3000

# MongoDB connection string.
# When running via docker-compose, the host is the `mongo` service name.
MONGO_URI=mongodb://root:example@mongo:27017/ems?authSource=admin

# Email agent mode: `demo` (simulated, no network) or `live` (real SMTP).
# Switching demo -> live requires ONLY changing this flag (no code changes).
EMAIL_MODE=demo

# Number of leads processed in parallel during a campaign run.
SEND_CONCURRENCY=3

# Comma-separated list of origins allowed to call the API (frontend).
# Use * to allow any origin (fine for the local demo).
CORS_ORIGIN=*

# ── Live SMTP settings (only used when EMAIL_MODE=live) ──────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user
SMTP_PASS=secret
SMTP_FROM=You <you@example.com>
