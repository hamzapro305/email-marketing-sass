# ─────────────────────────────────────────────────────────────
# Email Marketing SaaS — Backend environment
# Copy this file to `.env` and adjust as needed. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Backend HTTP port
PORT=3000

# MongoDB connection string.
# Running the backend on the HOST with Mongo in Docker → use localhost.
# (When the backend itself runs inside docker-compose, the compose file
#  overrides this to use the `mongo` service host automatically.)
MONGO_URI=mongodb://root:example@localhost:27017/ems?authSource=admin

# Redis connection — backs the BullMQ queue that distributes campaign sends
# across every backend replica. (Compose overrides the host to the `redis`
# service; use localhost when running the backend directly on the host.)
REDIS_HOST=localhost
REDIS_PORT=6379

# Per-replica worker concurrency. Total parallelism ≈ (replicas × this value).
SEND_CONCURRENCY=25

# Comma-separated list of origins allowed to call the API (frontend).
# Use * to allow any origin (fine for the local demo).
CORS_ORIGIN=*

# Google ADK email-writer sidecar. The backend calls it to write each email and
# transparently falls back to a built-in writer if it's unreachable.
# (Compose overrides this to http://email-writer:8000 inside the network.)
AI_WRITER_URL=http://localhost:8000

# ── SMTP sending ────────────────────────────────────────────────
# There are NO SMTP_* env vars anymore. Each user connects and manages their
# own SMTP account(s) in-app (Settings → Email accounts); one is the default
# sender. Campaigns cannot be started until a mailbox is connected.
