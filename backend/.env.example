# ─────────────────────────────────────────────────────────────
# Backend environment — host-side development (`npm run start:dev`).
# In Docker these are set by docker-compose.yml; SMTP + LLM credentials are
# configured in-app per user, never here.
# ─────────────────────────────────────────────────────────────

PORT=3000

# What this process does: api | worker | all (dev default: both in one process)
APP_ROLE=all

# Infra from `make dev` (Mongo/Redis published to the host by the dev override).
MONGO_URI=mongodb://root:example@localhost:27017/ems?authSource=admin
REDIS_HOST=localhost
REDIS_PORT=6379

# AI service (run it with: cd ai-service && uvicorn app.main:app --port 8000)
AI_SERVICE_URL=http://localhost:8000

CORS_ORIGIN=*

# At-rest encryption for user secrets (SMTP passwords, LLM API keys).
ENCRYPTION_KEY=dev-only-encryption-key

# Deliverability: public origin for unsubscribe links + per-account hourly cap.
PUBLIC_URL=http://localhost:3000
SEND_HOURLY_LIMIT=80

# Per-replica queue concurrency.
PIPELINE_CONCURRENCY=5
SEND_CONCURRENCY=10

# Research / scraping limits.
MAX_RIVALS=3
SCRAPE_MAX_PAGES_PER_SITE=4
SCRAPE_TIMEOUT_MS=10000
SCRAPE_MIN_DOMAIN_DELAY_MS=1500
SCRAPE_CACHE_TTL_HOURS=168
RESEARCH_CACHE_TTL_HOURS=168
