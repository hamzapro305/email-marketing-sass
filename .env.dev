# ─────────────────────────────────────────────────────────────
# DEV profile. `make dev` copies this to `.env` before starting the stack.
# Safe to commit — contains no real secrets. (SMTP + LLM credentials are
# configured in-app per user, never via env.)
# ─────────────────────────────────────────────────────────────

# ── Compose topology ─────────────────────────────────────────
API_REPLICAS=1            # HTTP servers behind the gateway
WORKER_REPLICAS=1         # pipeline + send workers (scale for throughput)
GATEWAY_PORT=3000         # app at http://localhost:3000 (API at /api)
MONGO_PORT=27017          # published to host by the dev override
REDIS_PORT=6379           # published to host by the dev override

# ── Datastore credentials (used by mongo + backend MONGO_URI) ─
MONGO_USER=root
MONGO_PASSWORD=example

# ── Backend app config ───────────────────────────────────────
PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
JWT_SECRET=dev-only-change-this-jwt-secret
CORS_ORIGIN=*             # any origin — fine for local dev

# At-rest encryption for user secrets (SMTP passwords, LLM API keys).
ENCRYPTION_KEY=dev-only-encryption-key

# ── Deliverability ───────────────────────────────────────────
# Public origin of the app — used for unsubscribe links inside emails.
PUBLIC_URL=http://localhost:3000
# Max emails per hour per SMTP account (0 = unlimited). Keeps sending smooth
# so providers don't flag bursts; Gmail free caps at ~500/day anyway.
SEND_HOURLY_LIMIT=80

# Per-replica queue concurrency. Total parallelism ≈ replicas × these.
PIPELINE_CONCURRENCY=5    # audit stages (research/scrape/analyze/email)
SEND_CONCURRENCY=10       # SMTP sends

# ── Research / scraping limits ───────────────────────────────
MAX_RIVALS=3                    # competitors researched per company
SCRAPE_MAX_PAGES_PER_SITE=4    # pages read per website
SCRAPE_TIMEOUT_MS=10000
SCRAPE_MIN_DOMAIN_DELAY_MS=1500 # politeness: min gap between hits per domain
SCRAPE_CACHE_TTL_HOURS=168      # scraped pages stay fresh for 7 days
RESEARCH_CACHE_TTL_HOURS=168    # company research reused for 7 days
