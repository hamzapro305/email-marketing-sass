# ─────────────────────────────────────────────────────────────
# Frontend (desktop app) environment
# Copy to `.env` and set the backend URL. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Base URL of the backend API (nginx entry point), including the /api prefix.
#
#   Local dev (containers on your machine):  http://localhost:3000/api
#   Deployed server:                         https://mail.example.com/api
#
# After deploying the containers to a server, set this to the server's URL and
# rebuild the desktop app (npm run make) — no code changes needed.
VITE_API_URL=http://localhost:3000/api
