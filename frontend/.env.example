# ─────────────────────────────────────────────────────────────
# Frontend environment (optional)
# Copy to `.env` if you need to override anything. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Base URL of the backend API. Leave unset for the default "/api" (same
# origin — the production nginx and the Vite dev server both proxy it).
# Only set this when the API lives on a different origin.
#VITE_API_URL=https://mail.example.com/api

# Dev-server proxy target for /api (defaults to http://localhost:3000).
#VITE_DEV_API_PROXY=http://localhost:3000
