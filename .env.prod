# ─────────────────────────────────────────────────────────────
# PROD profile. `make prod` copies this to `.env` before starting the stack.
#
# Commit this as a TEMPLATE only. Before a real deploy, change MONGO_PASSWORD
# and lock down CORS_ORIGIN. Do NOT commit real secrets — inject them on the
# server (e.g. an untracked .env.prod.local you copy in) instead. SMTP + LLM
# credentials are configured in-app per user, never via env.
# ─────────────────────────────────────────────────────────────

# ── Compose topology ─────────────────────────────────────────
API_REPLICAS=2            # HTTP servers behind the gateway
WORKER_REPLICAS=3         # pipeline + send workers (scale for throughput)
GATEWAY_PORT=80           # the gateway is the ONLY published port
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
JWT_SECRET=dev-only-change-this-jwt-secret

# NOTE: MONGO_PORT / REDIS_PORT are intentionally absent — in prod the
# datastores are never published to the host, only the gateway is.

# ── Datastore credentials (used by mongo + backend MONGO_URI) ─
MONGO_USER=root
MONGO_PASSWORD=change-me-before-deploy

# ── Server address ───────────────────────────────────────────
# The VPS IP (no domain) — the app's public address. The gateway serves the
# frontend AND proxies /api on this same origin, so the browser never makes a
# cross-origin request and CORS errors cannot happen.
PUBLIC_URL=http://169.58.90.213
BACKEND_DOMAIN=api.artisticdesign.tech

# ── Backend app config ───────────────────────────────────────
PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
JWT_SECRET=dev-only-change-this-jwt-secret
# Same-origin setup → CORS barely applies; `*` reflects any origin so tools
# like curl/Postman also work. Tighten to http://169.58.90.213 if you prefer.
CORS_ORIGIN=*

# At-rest encryption for user secrets (SMTP passwords, LLM API keys).
# REQUIRED in production — set a long random string and never change it after
# accounts exist (existing secrets would become undecryptable).
ENCRYPTION_KEY=change-me-long-random-string

# ── Deliverability ───────────────────────────────────────────
# Max emails per hour per SMTP account (0 = unlimited).
SEND_HOURLY_LIMIT=80

# Per-replica queue concurrency. Total parallelism ≈ replicas × these.
PIPELINE_CONCURRENCY=5    # audit stages (research/scrape/analyze/email)
SEND_CONCURRENCY=25       # SMTP sends

# ── Research / scraping limits ───────────────────────────────
MAX_RIVALS=3
SCRAPE_MAX_PAGES_PER_SITE=4
SCRAPE_TIMEOUT_MS=10000
SCRAPE_MIN_DOMAIN_DELAY_MS=1500
SCRAPE_CACHE_TTL_HOURS=168
RESEARCH_CACHE_TTL_HOURS=168
